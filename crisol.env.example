# =============================================================
# CRISOL — Variables de entorno
# Copiar este archivo como .env.local y completar los valores.
# NUNCA commitear .env.local al repositorio.
# Las variables NEXT_PUBLIC_* son visibles en el cliente.
# =============================================================


# -------------------------------------------------------------
# SUPABASE
# Dashboard: https://supabase.com/dashboard/project/TU_PROJECT
# -------------------------------------------------------------

# URL del proyecto (pública — va en el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anónima (pública — va en el cliente, segura con RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio (PRIVADA — solo server-side, nunca exponer)
# Usada en webhooks y operaciones de admin que bypassean RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ID del proyecto (para generar tipos con Supabase CLI)
SUPABASE_PROJECT_ID=xxxxxxxxxxxx


# -------------------------------------------------------------
# STRIPE CONNECT
# Dashboard: https://dashboard.stripe.com/apikeys
# Webhook: https://dashboard.stripe.com/webhooks
# -------------------------------------------------------------

# MODELO DE PAGOS (Phase 3 D-SPLIT): Single-account de plataforma.
# NO Stripe Connect. NO transfers. NO Express accounts.
# Stripe Connect Separate Charges & Transfers no esta disponible en Chile.
# El admin recibe el 100% de cada venta en esta cuenta.
# La comision queda en la cuenta del admin.
# El neto de cada artesano se liquida manualmente via transferencia bancaria
# y se registra en la tabla ARTISAN_PAYOUT (Phase 3 ledger contable interno).
# Los campos bancarios del artesano se restauraron en migracion 015.

# Clave publicable (pública — para Stripe Elements en el cliente)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# En desarrollo:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Clave secreta (PRIVADA — solo server-side, cuenta personal del admin)
STRIPE_SECRET_KEY=sk_live_...
# En desarrollo:
# STRIPE_SECRET_KEY=sk_test_...

# Secreto del webhook (PRIVADA — para verificar eventos de Stripe)
# Obtener en: Dashboard → Webhooks → Tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Eventos que debe escuchar el webhook:
# - payment_intent.succeeded  → marcar ORDER como pagado, crear PAYMENT
# - payment_intent.payment_failed → notificar al comprador

# Version de API Stripe (referencia documental — pinneada en src/lib/stripe/client.ts).
# NO se lee en runtime; pinearla en el SDK previene auto-upgrades silenciosos.
STRIPE_API_VERSION=2024-06-20


# -------------------------------------------------------------
# COINBASE COMMERCE (pagos en cripto)
# Dashboard: https://commerce.coinbase.com/settings/security
# -------------------------------------------------------------

# API Key (PRIVADA)
COINBASE_COMMERCE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secreto del webhook (PRIVADA)
# Obtener en: Commerce Dashboard → Settings → Webhook subscriptions
COINBASE_COMMERCE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -------------------------------------------------------------
# CLOUDINARY (multimedia CDN)
# Dashboard: https://cloudinary.com/console
# -------------------------------------------------------------

# Nombre del cloud (público — va en el cliente para uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=crisol-store

# API Key (pública en Cloudinary, pero mejor mantener privada)
CLOUDINARY_API_KEY=123456789012345

# API Secret (PRIVADA — nunca exponer)
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Upload Preset sin firmar (para uploads directos desde el cliente)
# Crear en: Settings → Upload → Upload presets → Add preset (unsigned)
CLOUDINARY_UPLOAD_PRESET=crisol_pieces

# Carpeta base en Cloudinary para organizar assets
CLOUDINARY_BASE_FOLDER=crisol


# -------------------------------------------------------------
# RESEND (email transaccional)
# Dashboard: https://resend.com/api-keys
# -------------------------------------------------------------

# API Key (PRIVADA)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email del remitente (debe estar verificado en Resend)
RESEND_FROM_EMAIL=noreply@crisol.cl
RESEND_FROM_NAME=Crisol

# Email de notificaciones del admin
RESEND_ADMIN_EMAIL=admin@crisol.cl


# -------------------------------------------------------------
# COURIERS — Nacionales
# -------------------------------------------------------------

# Chilexpress
# Solicitar en: https://developers.chilexpress.cl
CHILEXPRESS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHILEXPRESS_COD_CUENTA=123456

# Starken
# Solicitar en: https://www.starken.cl/api-starken
STARKEN_USER=usuario@crisol.cl
STARKEN_PASSWORD=xxxxxxxx


# -------------------------------------------------------------
# COURIERS — Internacionales
# -------------------------------------------------------------

# DHL Express
# Solicitar en: https://developer.dhl.com
DHL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DHL_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DHL_ACCOUNT_NUMBER=123456789

# FedEx
# Solicitar en: https://developer.fedex.com
FEDEX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEDEX_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEDEX_ACCOUNT_NUMBER=XXXXXXXXX


# -------------------------------------------------------------
# GOOGLE (Analytics, Search Console)
# -------------------------------------------------------------

# Google Analytics 4
# Obtener en: https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console (para la API integrada en el panel admin)
# Crear Service Account en: https://console.cloud.google.com
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=crisol@crisol-seo.iam.gserviceaccount.com
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://www.crisol.cl


# -------------------------------------------------------------
# APLICACIÓN
# -------------------------------------------------------------

# URL pública de la app (sin trailing slash)
NEXT_PUBLIC_APP_URL=https://www.crisol.cl
# En desarrollo:
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto para endpoints de cron jobs y revalidación manual
# Generar: openssl rand -base64 32
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreto para on-demand ISR revalidation desde webhooks externos
REVALIDATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -------------------------------------------------------------
# TIPO DE CAMBIO (opcional — si usas un proveedor externo)
# Por defecto el sistema usa un endpoint propio /api/currency
# que consulta una API pública de tipo de cambio CLP/USD
# -------------------------------------------------------------

# Proveedor de tipo de cambio (opcional)
# EXCHANGE_RATE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================
# VARIABLES SOLO EN PRODUCCIÓN (.env.production o Vercel)
# Estas NO deben estar en .env.local en desarrollo
# =============================================================

# NODE_ENV=production
# NEXT_TELEMETRY_DISABLED=1


# =============================================================
# CHECKLIST DE CONFIGURACIÓN ANTES DEL LANZAMIENTO
# =============================================================
#
# Supabase:
# [ ] Ejecutar todas las migraciones (001 → 008)
# [ ] Verificar que RLS está activo en todas las tablas
# [ ] Configurar OAuth providers (Google, Apple) si aplica
# [ ] Configurar Storage buckets con políticas correctas
#
# Stripe:
# [ ] Crear cuenta Stripe Connect para cada artesano
# [ ] Configurar webhook con los eventos requeridos
# [ ] Verificar split payment en modo test antes de producción
# [ ] Activar modo live (reemplazar claves pk_test / sk_test)
#
# Cloudinary:
# [ ] Crear upload preset unsigned para piezas
# [ ] Configurar transformaciones automáticas (WebP/AVIF)
# [ ] Verificar CDN delivery con URL de prueba
#
# Resend:
# [ ] Verificar dominio (DNS: SPF, DKIM, DMARC)
# [ ] Probar todos los templates de email
#
# Couriers:
# [ ] Verificar credenciales de cada API en sandbox
# [ ] Probar cotización de envío con dirección de prueba
#
# SEO:
# [ ] Configurar Google Search Console con el dominio
# [ ] Verificar robots.txt permite los bots correctos
# [ ] Confirmar que llms.txt está accesible en /llms.txt
# [ ] Conectar GA4 Property con el dominio
#
